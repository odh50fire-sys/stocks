<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_widget"
    android:padding="8dp">

    <!-- Header: 24H STOCKS + 실시간 ON/OFF 토글 + 수동 동기화 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="24H STOCKS"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_toggle_realtime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ 실시간 OFF"
            android:textColor="#94A3B8"
            android:background="#1E293B"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_marginEnd="5dp" />

        <TextView
            android:id="@+id/widget_sync_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄 동기화"
            android:textColor="#E2E8F0"
            android:background="#0F172A"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </LinearLayout>

    <!-- 6 Rows (Each with 2 Distinct Card Boxes) -->
    <!-- Row 1: W 코스피200 / W 나스닥100 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">
        <!-- Card 1 (Left) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_card_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="4dp">
            <TextView android:id="@+id/w_sub_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="W 코스피200" android:textColor="@color/text_white" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_item_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-1.76%" android:textColor="@color/stock_down" android:textSize="22sp" android:textStyle="bold" />
        </LinearLayout>
        <!-- Card 2 (Right) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_card_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="4dp">
            <TextView android:id="@+id/w_sub_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="W 나스닥100" android:textColor="@color/text_white" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_item_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+0.56%" android:textColor="@color/stock_up" android:textSize="22sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2: W Tech 100 / W Oil -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">
        <!-- Card 3 (Left) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_card_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="4dp">
            <TextView android:id="@+id/w_sub_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="W Tech 100" android:textColor="@color/text_white" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_item_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+0.45%" android:textColor="@color/stock_up" android:textSize="22sp" android:textStyle="bold" />
        </LinearLayout>
        <!-- Card 4 (Right) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_card_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="4dp">
            <TextView android:id="@+id/w_sub_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="W Oil (Crude)" android:textColor="@color/text_white" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_item_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-0.32%" android:textColor="@color/stock_down" android:textSize="22sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 3: SK하이닉스 / 삼성전자 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">
        <!-- Card 5 (Left) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_card_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="4dp">
            <TextView android:id="@+id/w_sub_5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="SK하이닉스" android:textColor="@color/text_white" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_item_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-0.01%" android:textColor="@color/stock_down" android:textSize="22sp" android:textStyle="bold" />
        </LinearLayout>
        <!-- Card 6 (Right) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_card_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="4dp">
            <TextView android:id="@+id/w_sub_6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="삼성전자" android:textColor="@color/text_white" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_item_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-2.28%" android:textColor="@color/stock_down" android:textSize="22sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 4: 삼성전기 / 마이크론 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">
        <!-- Card 7 (Left) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_card_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="4dp">
            <TextView android:id="@+id/w_sub_7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="삼성전기" android:textColor="@color/text_white" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_item_7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-4.06%" android:textColor="@color/stock_down" android:textSize="22sp" android:textStyle="bold" />
        </LinearLayout>
        <!-- Card 8 (Right) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_card_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="4dp">
            <TextView android:id="@+id/w_sub_8" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="마이크론" android:textColor="@color/text_white" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_item_8" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+2.49%" android:textColor="@color/stock_up" android:textSize="22sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 5: 팔란티어 / 엔비디아 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">
        <!-- Card 9 (Left) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_card_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="4dp">
            <TextView android:id="@+id/w_sub_9" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="팔란티어" android:textColor="@color/text_white" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_item_9" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+0.62%" android:textColor="@color/stock_up" android:textSize="22sp" android:textStyle="bold" />
        </LinearLayout>
        <!-- Card 10 (Right) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_card_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="4dp">
            <TextView android:id="@+id/w_sub_10" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="엔비디아" android:textColor="@color/text_white" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_item_10" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-0.09%" android:textColor="@color/stock_down" android:textSize="22sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 6: 메타 / 테슬라 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <!-- Card 11 (Left) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_card_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="4dp">
            <TextView android:id="@+id/w_sub_11" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="메타" android:textColor="@color/text_white" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_item_11" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-0.04%" android:textColor="@color/stock_down" android:textSize="22sp" android:textStyle="bold" />
        </LinearLayout>
        <!-- Card 12 (Right) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_card_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="4dp">
            <TextView android:id="@+id/w_sub_12" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="테슬라" android:textColor="@color/text_white" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_item_12" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+0.09%" android:textColor="@color/stock_up" android:textSize="22sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
