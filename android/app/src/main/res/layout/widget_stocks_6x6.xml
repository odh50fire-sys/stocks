            android:gravity="center_vertical"
            android:background="@drawable/widget_card_bg"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="2dp"
            android:layout_marginEnd="4dp">
