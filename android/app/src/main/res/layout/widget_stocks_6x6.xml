                <TextView android:id="@+id/w_sub_8" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="마이크론" android:textColor="@color/text_white" android:textSize="14sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
