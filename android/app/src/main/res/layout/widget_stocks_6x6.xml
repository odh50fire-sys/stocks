<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_widget"
    android:padding="8dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="24H STOCKS (6x6)"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE"
            android:textColor="#10B981"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 6 Rows (Each with 2 columns) -->
    <!-- Row 1: KR200 / NQ100 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:padding="2dp">
            <TextView android:id="@+id/w_sub_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="1.코스피200" android:textColor="@color/text_white" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_item_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-1.76%" android:textColor="@color/stock_down" android:textSize="24sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:padding="2dp">
            <TextView android:id="@+id/w_sub_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="2.나스닥100" android:textColor="@color/text_white" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_item_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+0.56%" android:textColor="@color/stock_up" android:textSize="24sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2: Tech100 / Oil -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:padding="2dp">
            <TextView android:id="@+id/w_sub_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="3.Tech100" android:textColor="@color/text_white" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_item_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+0.45%" android:textColor="@color/stock_up" android:textSize="24sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:padding="2dp">
            <TextView android:id="@+id/w_sub_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="4.Oil(WTI)" android:textColor="@color/text_white" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_item_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-0.32%" android:textColor="@color/stock_down" android:textSize="24sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 3: SKHX / SMSN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:padding="2dp">
            <TextView android:id="@+id/w_sub_5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="5.SK하이닉스" android:textColor="@color/text_white" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_item_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+0.04%" android:textColor="@color/stock_up" android:textSize="24sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:padding="2dp">
            <TextView android:id="@+id/w_sub_6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="6.삼성전자" android:textColor="@color/text_white" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_item_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-2.28%" android:textColor="@color/stock_down" android:textSize="24sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 4: SAMSUNGEM / MU -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:padding="2dp">
            <TextView android:id="@+id/w_sub_7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="7.삼성전기" android:textColor="@color/text_white" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_item_7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-7.50%" android:textColor="@color/stock_down" android:textSize="24sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:padding="2dp">
            <TextView android:id="@+id/w_sub_8" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="8.마이크론" android:textColor="@color/text_white" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_item_8" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+2.49%" android:textColor="@color/stock_up" android:textSize="24sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 5: PLTR / NVDA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:padding="2dp">
            <TextView android:id="@+id/w_sub_9" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="9.팔란티어" android:textColor="@color/text_white" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_item_9" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+0.62%" android:textColor="@color/stock_up" android:textSize="24sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:padding="2dp">
            <TextView android:id="@+id/w_sub_10" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="10.엔비디아" android:textColor="@color/text_white" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_item_10" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-0.09%" android:textColor="@color/stock_down" android:textSize="24sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 6: META / TSLA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:padding="2dp">
            <TextView android:id="@+id/w_sub_11" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="11.메타" android:textColor="@color/text_white" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_item_11" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-0.04%" android:textColor="@color/stock_down" android:textSize="24sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:padding="2dp">
            <TextView android:id="@+id/w_sub_12" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="12.테슬라" android:textColor="@color/text_white" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_item_12" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+0.09%" android:textColor="@color/stock_up" android:textSize="24sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
